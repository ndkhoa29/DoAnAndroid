<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thanh dau trang -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white">

            <!-- Nut quay lai -->
            <ImageButton
                android:id="@+id/nutQuayLai"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Quay lai" />

            <!-- Tieu de man hinh -->
            <TextView
                android:id="@+id/tieuDeManHinh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="My Frofile"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Nut chinh sua o phia tren ben phai -->
            <ImageButton
                android:id="@+id/nutChinhSua"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                android:contentDescription="Chinh sua" />
        </RelativeLayout>

        <!-- Anh dai dien / Avatar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp">

            <!-- Anh dai dien hinh tron -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/anhDaiDien"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_provider_avatar"
                app:civ_border_color="#E0E0E0"
                app:civ_border_width="2dp" />
        </RelativeLayout>

        <!-- Truong Ho va ten -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <!-- Label Ho va ten -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Ho va ten"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <!-- Input Ho va ten -->
            <EditText
                android:id="@+id/nhapHoVaTen"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_background"
                android:hint="Nhap ho va ten"
                android:text="abc"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:inputType="textPersonName" />
        </LinearLayout>

        <!-- Truong Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <!-- Label Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Dia chi email"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <!-- Input Email -->
            <EditText
                android:id="@+id/nhapEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_background"
                android:hint="Nhap dia chi email"
                android:text="abc2gmail.com"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- Truong So dien thoai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            android:orientation="vertical">

            <!-- Label So dien thoai -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="So dien thoai"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <!-- Input So dien thoai kem vien -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_background"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Vien ben trai -->

                <!-- EditText So dien thoai -->
                <EditText
                    android:id="@+id/nhapSoDienThoai"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Nhap so dien thoai"
                    android:text="9956358965"
                    android:paddingStart="8dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:inputType="phone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nut Luu thay doi -->

    </LinearLayout>
</ScrollView>
