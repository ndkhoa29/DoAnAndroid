<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#FFFFFF"
    android:padding="32dp">

    <!-- Khung chua noi dung chinh -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo ung dung -->
        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_logo"
            android:adjustViewBounds="true"
            android:contentDescription="App Logo" />

        <!-- Tieu de chinh -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="Ultimate House Cleaning Services"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Mo ta ngan ve dich vu -->
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Interior and exterior window washing to let the light shine through."
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Nut bat dau (Get Started) o duoi man hinh -->
    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Get Started"
        android:textColor="@android:color/white"
        android:background="@drawable/button_background"
        android:minHeight="56dp"
        android:textSize="18sp"
        android:textStyle="bold" />

</RelativeLayout>
